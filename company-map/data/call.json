{
  "rules": [
    {
      "b": {
        "en": "Operators start with their Portfolio Manager."
      },
      "s": {
        "en": "Every question, every problem, every time."
      }
    },
    {
      "b": {
        "en": "Portfolio Managers start with Moharam."
      },
      "s": {
        "en": "Money and gear go to Mano. Quality goes to Youssef Medhat."
      }
    },
    {
      "b": {
        "en": "Nobody contacts the client."
      },
      "s": {
        "en": "Not for any reason. Adham handles everything client-facing."
      }
    }
  ],
  "nodes": {
    "you": {
      "en": "You"
    },
    "anchor": {
      "en": "Your operator"
    },
    "pm": {
      "en": "Your Portfolio Manager"
    },
    "moharam": {
      "en": "Moharam"
    },
    "mano": {
      "en": "Mano"
    },
    "adham": {
      "en": "Adham"
    },
    "youssif": {
      "en": "Youssif"
    },
    "joe": {
      "en": "Youssef Medhat"
    },
    "ali": {
      "en": "Ali"
    },
    "site": {
      "en": "Site medical staff"
    },
    "hours": {
      "en": "Open office hours"
    }
  },
  "groups": [
    {
